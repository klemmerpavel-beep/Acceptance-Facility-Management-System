# Окружение стенда. Скопируйте в .env и правьте значения.
# Реальные секреты в репозиторий не попадают: .env исключён из индексации.

POSTGRES_USER=priyomka
POSTGRES_PASSWORD=смените_на_стенде
POSTGRES_DB=priyomka

# Строка подключения для API внутри compose.
DATABASE_URL=postgresql://priyomka:смените_на_стенде@postgres:5432/priyomka

# Каталог хранилища файлов: план объекта, дальше — фотоотчёты и чеки.
# Реализация порта FileStorage одна, на файловой системе; каталогу нужен том.
STORAGE_DIR=/var/lib/priyomka/files

# Объектное хранилище S3 — второй адаптер FileStorage, вводится при переезде
# в российское облако (план 6.1). Кодом пока не читается, и в docker-compose.yml
# его нет: образ MinIO из Docker Hub недоступен (П-55). Значения — облака.
# S3_ENDPOINT=https://storage.example.ru
# S3_BUCKET=priyomka
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Источник веб-клиента для CORS. На стенде совпадает с адресом vite.
WEB_ORIGIN=http://localhost:5173
PORT=3000

# Режим поставки — промышленный: код входа и ссылка уходят сообщением и
# письмом, в ответ сервера не попадают. Отправщик подключается к пилоту.
NODE_ENV=production

# Стенд для показа и проверок: код входа и ссылка — прямо в ответе и на
# экране. Только вместе с NODE_ENV=development; с production сервер не
# запустится. Включённый флаг пускает руководителем любого, кто знает его
# почту или номер, — на машине, видимой из сети, его не ставят.
# AUTH_ECHO=1
