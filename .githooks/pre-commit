#!/bin/sh
#
# Проверка слоя представления перед фиксацией.
#
# Правило, которое никто не проверяет, нарушается на третьей неделе.
# Механические правила дизайн-системы — значение мимо токена, недобор
# контраста, мёртвое правило, глиф в роли иконки — держатся тестом, но
# тест надо не забыть запустить. Хук запускает его сам и только тогда,
# когда в фиксацию попал слой представления: на правку сервера он не
# тратит ни секунды.
#
# Включается один раз на машине разработчика:
#     git config core.hooksPath .githooks
#
# Обойти в исключительном случае: git commit --no-verify

set -e

changed=$(git diff --cached --name-only --diff-filter=ACM)

touches_ui=$(printf '%s\n' "$changed" | grep -E '^(packages/ui/|apps/web/src/|design/)' || true)
if [ -z "$touches_ui" ]; then
  exit 0
fi

echo "Слой представления изменён — проверяю дизайн-систему."

if ! npx vitest run packages/ui --silent; then
  echo
  echo "Проверка дизайн-системы не прошла. Фиксация отменена."
  echo "Норматив: docs/03_DESIGN_SYSTEM.md."
  exit 1
fi

# Разметка проверяется отдельно и требует поднятого стенда: если его нет,
# хук не мешает фиксации, а называет пропущенную проверку.
if curl -sf -o /dev/null --max-time 2 http://127.0.0.1:5173/ 2>/dev/null; then
  echo "Стенд отвечает — проверяю страницу."
  node scripts/verify-page.mjs || {
    echo
    echo "Проверка страницы не прошла. Фиксация отменена."
    exit 1
  }
else
  echo "Стенд не поднят: проверка страницы пропущена. Запустите её перед выкладкой."
fi
