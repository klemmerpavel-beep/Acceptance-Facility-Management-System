#!/bin/sh
#
# Проверка кода и слоя представления перед фиксацией.
#
# Правило, которое никто не проверяет, нарушается на третьей неделе.
# Хук запускает проверки сам и ровно те, что относятся к правке:
#
#   правка любого модуля  → линт (деньги, литералы цвета и размера, типы);
#   правка представления  → плюс тест дизайн-системы, а при поднятом
#                           стенде — ещё и обход страницы.
#
# На правке одного лишь docs/ или миграции хук не тратит ни секунды.
#
# Хук — удобство разработчика, а не рубеж: он включается вручную и
# обходится ключом. Обязательны те же проверки в .github/workflows/ci.yml.
#
# Включается один раз на машине разработчика:
#     git config core.hooksPath .githooks
#
# Обойти в исключительном случае: git commit --no-verify

set -e

changed=$(git diff --cached --name-only --diff-filter=ACM)

# Линт с учётом типов ставится первым и запускается на любой правке кода:
# денежная величина типа number и цветовой литерал мимо токена — дефекты
# независимо от того, тронут ли слой представления.
touches_code=$(printf '%s\n' "$changed" | grep -E '\.(ts|tsx|mjs)$' || true)
if [ -n "$touches_code" ]; then
  echo "Код изменён — линт."
  if ! pnpm lint; then
    echo
    echo "Линт не прошёл. Фиксация отменена."
    echo "Конфигурация и обоснования отключений: eslint.config.mjs."
    exit 1
  fi
fi

touches_ui=$(printf '%s\n' "$changed" | grep -E '^(packages/ui/|apps/web/src/|design/)' || true)
if [ -z "$touches_ui" ]; then
  exit 0
fi

echo "Слой представления изменён — проверяю дизайн-систему."

if ! npx vitest run packages/ui --silent; then
  echo
  echo "Проверка дизайн-системы не прошла. Фиксация отменена."
  echo "Норматив: docs/03_DESIGN_SYSTEM.md."
  exit 1
fi

# Разметка проверяется отдельно и требует поднятого стенда: если его нет,
# хук не мешает фиксации, а называет пропущенную проверку.
if curl -sf -o /dev/null --max-time 2 http://127.0.0.1:5173/ 2>/dev/null; then
  echo "Стенд отвечает — проверяю страницу."
  node scripts/verify-page.mjs || {
    echo
    echo "Проверка страницы не прошла. Фиксация отменена."
    exit 1
  }
else
  echo "Стенд не поднят: проверка страницы пропущена. Запустите её перед выкладкой."
fi
