// Схема базы данных «Приёмки».
//
// Денежные величины — BigInt копеек (БП-08). Количества — BigInt тысячных
// долей единицы измерения. Доли и проценты — Int сотых долей процента.
// Тип с плавающей точкой для денег не используется нигде.
//
// Миграции только вперёд, применяются с нуля на чистой базе в CI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Роли системы. Клиент личного кабинета в первой версии не имеет
/// и в таблице пользователей не заводится.
enum Role {
  OWNER
  FOREMAN
  SUPPLY
}

/// Текущий рабочий статус объекта.
enum ProjectStatus {
  NEW
  IN_PROGRESS
  PAUSED
  WAITING_CLIENT
  DONE
  ARCHIVED
}

/// Состояние транша.
///
/// Закрытие и оплата разделены намеренно: транш закрывается, когда работы
/// по нему выработаны, а оплачивается, когда деньги пришли, — между этими
/// событиями проходят дни, и склеивание их в один статус скрыло бы от
/// руководителя именно тот промежуток, за которым он следит.
enum TrancheStatus {
  /// Накапливает выработку. Открытый транш у объекта не более одного.
  OPEN
  /// Закрыт руководителем. Формирование акта — пункт плана 4.7.
  CLOSED
  /// Оплачен клиентом.
  PAID
}

/// Расчётная единица сдельной оплаты. По решению допроса расчёт ведётся
/// с бригадой через бригадира, состав бригады не хранится; тип PERSON
/// оставлен для объектов, где рассчитываются с конкретным мастером.
/// Вид проёма обмерного плана. Величины хранятся измеренными итогами по
/// виду, а не выводятся из размеров: у двери спальни площадь 1,68 м² и
/// откосы 5,05 м.п. не даёт ни одна пара размеров — откосы у двери
/// трёхсторонние и меряются по месту.
enum OpeningKind {
  WINDOW
  DOOR
}

/// Набор обмера. Их ровно два, и это не заготовка под список: заказчик
/// назвал задачу «второй набор — после перепланировки, рядом с начальным».
/// Перечисление из двух значений отвечает на этот вопрос и ни на какой
/// другой; список наборов с именами и порядком отвечал бы на вопрос,
/// которого никто не задавал, и стоил бы отдельного экрана управления ими.
///
/// INITIAL — обмер до работ, по нему считалась смета.
/// REPLANNED — обмер после перепланировки: снесённые перегородки меняют
/// площади, и прежние величины перестают быть правдой, не переставая быть
/// историей. Поэтому второй набор именно рядом с первым, а не поверх него.
enum MeasureSet {
  INITIAL
  REPLANNED
}

/// Состояние расхода по чеку.
///
/// Три значения, а не два. Отклонённый не удаляется: история не
/// переписывается (БП-04), и «почему этот чек не возместили» спрашивают
/// через месяц — так же, как «кто перевёл объект в паузу». Удаление
/// допускается только для черновика: он ещё ничего не значит.
enum ExpenseStatus {
  DRAFT
  CONFIRMED
  REJECTED
}

/// Вид расхода. Список закрытый — решение заказчика от 13.09.2026.
enum ExpenseKind {
  MATERIALS
  DELIVERY
  TOOLS
  OTHER
}

enum WorkerKind {
  BRIGADE
  PERSON
}

/// Стадия воронки заявок. Четыре, по фактическому процессу компании
/// (01_PROJECT.md, раздел 4, шаги 1–3) и утверждённому макету.
enum LeadStage {
  /// Обращение поступило, разговора ещё не было.
  FIRST_CONTACT
  /// Выезд на объект, знакомство и обмер.
  MEETING
  /// Смета составлена, заказчик думает.
  DECIDING
  /// Договор и предоплата 30 %.
  CONTRACT
}

/// Исход заявки. Выигранная и отказная уходят из воронки, но не удаляются:
/// история не переписывается (БП-04).
enum LeadOutcome {
  OPEN
  WON
  LOST
}

/// Назначение одноразовой ссылки входа.
enum AuthPurpose {
  /// Магическая ссылка руководителя, живёт минуты.
  MAGIC_LINK
  /// Персональная ссылка прораба: он не вводит ничего вообще.
  FOREMAN_LINK
  /// Код подтверждения из шести цифр, живёт пять минут.
  SMS_CODE
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  /// Часовой пояс организации в виде IANA: сроки объектов считаются в нём,
  /// а не в поясе браузера того, кто открыл страницу.
  timeZone  String   @default("Europe/Moscow")
  /// Валюта учёта. Одна на организацию: смета, начисления и акты в разных
  /// валютах не складываются.
  currency  String   @default("RUB")
  phone     String?
  email     String?
  /// Ключ логотипа в объектном хранилище. Сам файл в базе не лежит.
  logoKey   String?
  createdAt DateTime @default(now())

  users       User[]
  clients     Client[]
  projects    Project[]
  workers     Worker[]
  units       Unit[]
  auditLog    AuditLog[]
  leads       Lead[]
  leadTasks   LeadTask[]
  repairTypes RepairType[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  role      Role
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  organization      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authTokens        AuthToken[]
  sessions          Session[]
  projectsAsForeman Project[]         @relation("ProjectForeman")
  auditEntries      AuditLog[]
  measurePlans      MeasurePlan[]
  acceptanceBatches AcceptanceBatch[]
  acceptances       Acceptance[]
  acceptancePhotos  AcceptancePhoto[]
  tranches          Tranche[]
  expensesCreated   MaterialExpense[] @relation("ExpenseAuthor")
  expensesConfirmed MaterialExpense[] @relation("ExpenseConfirmer")

  @@unique([orgId, email])
  @@index([orgId, role])
  @@map("users")
}

model Client {
  id         String  @id @default(uuid()) @db.Uuid
  orgId      String  @db.Uuid
  /// Короткий код клиента, как в обиходе заказчика: [300] И. Иванов.
  code       String
  name       String
  isCompany  Boolean @default(false)
  requisites String?

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]
  leads        Lead[]

  @@unique([orgId, code])
  @@map("clients")
}

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  orgId            String        @db.Uuid
  /// Сквозной короткий код объекта: почта, документы, разговор, акт — R-99.
  code             String
  address          String
  clientId         String        @db.Uuid
  foremanId        String?       @db.Uuid
  status           ProjectStatus @default(NEW)
  /// Дата начала работ на объекте. Отличается от даты заведения объекта в
  /// системе: объект может быть заведён задолго до выхода бригады.
  startedAt        DateTime?     @db.Date
  deadline         DateTime?     @db.Date
  keysCount        Int           @default(0)
  /// Надбавка «сопровождение объекта» в сотых долях процента: 1200 = 12,00 %.
  supervisionShare Int           @default(1200)
  createdAt        DateTime      @default(now())

  organization      Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  foreman           User?             @relation("ProjectForeman", fields: [foremanId], references: [id], onDelete: SetNull)
  estimates         Estimate[]
  measureRooms      MeasureRoom[]
  /// Планов столько же, сколько наборов обмера: по одному на набор.
  measurePlans      MeasurePlan[]
  expenses          MaterialExpense[]
  workStages        WorkStage[]
  acceptanceBatches AcceptanceBatch[]
  tranches          Tranche[]
  /// Заявка, из которой объект заведён. Её нет у объектов, заведённых руками.
  lead              Lead?

  @@unique([orgId, code])
  @@index([orgId, status])
  @@map("projects")
}

/// Нормализованный справочник единиц измерения. Редактируется руководителем:
/// в сметах встречаются написания, которых нет в каноническом наборе.
model Unit {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @db.Uuid
  /// Каноническая форма: м², м.п., шт, точка, ед, рейс, ч/ч, этаж, %.
  code  String

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  estimateItems EstimateItem[]
  otherExpenses OtherExpense[]

  @@unique([orgId, code])
  @@map("units")
}

/// Смета объекта.
///
/// Редакция растёт **только при импорте**. Правка позиции — количества,
/// наименования, единицы, цены и ставки — идёт на месте с записью прежнего
/// значения в AuditLog (Р11 в редакции от 09.09.2026, БП-10).
///
/// Прежняя формулировка «цены и ставки порождают новую версию» снята: приёмка
/// ссылается на позицию конкретной редакции, связи между редакциями позиции
/// нет, и правка одной цены унесла бы всё принятое из вида приёмки, оставив
/// его в выработке транша. Начисленное защищено снимком ставки (БП-03).
model Estimate {
  id                 String   @id @default(uuid()) @db.Uuid
  projectId          String   @db.Uuid
  version            Int      @default(1)
  /// Надбавка «сопровождение объекта» в сотых долях процента.
  supervisionShare   Int      @default(1200)
  /// Заявленный в исходном файле итог по работам, копейки. Хранится, чтобы
  /// расхождение оставалось проверяемым и после импорта (БП-09).
  declaredWorksTotal BigInt?
  /// Объявлено, но ни одной строкой кода не читается и не пишется. Долг
  /// назван прямо, чтобы разбор охраны не принял его за работающую защиту:
  /// снятие поля требует миграции, применение — решения о том, кто и когда
  /// запирает смету.
  isLocked           Boolean  @default(false)
  createdAt          DateTime @default(now())

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections      EstimateSection[]
  items         EstimateItem[]
  otherExpenses OtherExpense[]
  imports       EstimateImport[]

  @@unique([projectId, version])
  @@map("estimates")
}

/// Раздел сметы. Вложенность — через parentId; в файле заказчика два уровня.
model EstimateSection {
  id         String  @id @default(uuid()) @db.Uuid
  estimateId String  @db.Uuid
  parentId   String? @db.Uuid
  name       String
  order      Int
  /// Строка исходного файла: связь с источником для разбора расхождений.
  sourceRow  Int?

  estimate Estimate          @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  parent   EstimateSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children EstimateSection[] @relation("SectionTree")
  items    EstimateItem[]
  stage    WorkStage?
  batches  AcceptanceBatch[]
  expenses MaterialExpense[]

  @@index([estimateId, order])
  @@map("estimate_sections")
}

/// Позиция сметы. Приёмке подлежат именно эти строки.
model EstimateItem {
  id         String @id @default(uuid()) @db.Uuid
  estimateId String @db.Uuid
  sectionId  String @db.Uuid
  unitId     String @db.Uuid
  name       String
  order      Int
  /// Количество в тысячных долях единицы измерения.
  qty        BigInt
  /// Цена единицы и ставка оплаты труда, копейки.
  unitPrice  BigInt
  unitWage   BigInt @default(0)
  sourceRow  Int?

  estimate    Estimate        @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section     EstimateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  acceptances Acceptance[]

  @@index([estimateId, order])
  @@index([sectionId, order])
  @@map("estimate_items")
}

/// Прочий расход: цена без объёма. Входит в итог сметы, приёмке не подлежит.
model OtherExpense {
  id         String @id @default(uuid()) @db.Uuid
  estimateId String @db.Uuid
  unitId     String @db.Uuid
  name       String
  order      Int
  unitPrice  BigInt
  sourceRow  Int?

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  unit     Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([estimateId, order])
  @@map("other_expenses")
}

/// Протокол импорта с отчётом о расхождениях. Отчёт хранится целиком:
/// он и есть главное доказательство ценности системы, и его нельзя
/// потерять при следующем импорте.
model EstimateImport {
  id                 String   @id @default(uuid()) @db.Uuid
  estimateId         String   @db.Uuid
  fileName           String
  importedById       String?  @db.Uuid
  importedAt         DateTime @default(now())
  positions          Int
  sectionsTotal      Int
  computedWorksTotal BigInt
  declaredWorksTotal BigInt?
  /// Пересчёт минус заявленное. Положительное — недосчёт в файле.
  worksTotalDelta    BigInt?
  report             Json

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId, importedAt])
  @@map("estimate_imports")
}

model Worker {
  id          String     @id @default(uuid()) @db.Uuid
  orgId       String     @db.Uuid
  name        String
  kind        WorkerKind @default(BRIGADE)
  /// Ставка по умолчанию в копейках за единицу; необязательна, поскольку
  /// начисление всегда идёт по ставке позиции сметы, а не по этой.
  defaultRate BigInt?

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workStages   WorkStage[]
  batches      AcceptanceBatch[]
  accruals     WageAccrual[]

  @@unique([orgId, name])
  @@map("workers")
}

model AuthToken {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  /// Хранится только хеш: утечка таблицы не даёт войти.
  tokenHash String      @unique
  purpose   AuthPurpose
  expiresAt DateTime
  usedAt    DateTime?
  /// Число неудачных попыток обмена. Код из шести цифр перебирается за
  /// миллион запросов, поэтому попытки ограничены, а не только время жизни.
  attempts  Int         @default(0)
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Журнал аудита. Обязателен для всех денежных полей (БП-10).
/// Записи не удаляются и не изменяются.
model AuditLog {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @db.Uuid
  actorId  String?  @db.Uuid
  entity   String
  entityId String
  field    String
  oldValue String?
  newValue String?
  at       DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, entity, entityId])
  @@index([orgId, at])
  @@map("audit_log")
}

/// Помещение обмерного плана.
///
/// Прораб вносит четыре величины: площадь пола, периметр пола, периметр
/// потолка и высоту. Площадь стен и объём в базе НЕ хранятся — они
/// выводятся чистыми функциями packages/domain/src/measure.ts. Хранение
/// производной завело бы вторую правду о тех же числах, расходящуюся с
/// первой при первой же правке высоты.
///
/// Периметр пола меньше периметра потолка на ширину дверных проёмов:
/// первый — длина плинтуса, второй — замкнутая линия примыкания стен к
/// потолку. Обе величины измеряются, ни одна не выводится из площади.
model MeasureRoom {
  id               String     @id @default(uuid()) @db.Uuid
  projectId        String     @db.Uuid
  /// Набор, к которому относится помещение. Значение по умолчанию делает
  /// миграцию безоговорочной: всё, что уже обмерено, — обмер начальный.
  set              MeasureSet @default(INITIAL)
  name             String
  order            Int
  /// Тысячные доли единицы, как количества сметы: 18,40 м² → 18400.
  floorArea        BigInt
  floorPerimeter   BigInt
  ceilingPerimeter BigInt
  height           BigInt
  createdAt        DateTime   @default(now())

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openings MeasureOpening[]

  /// Имя помещения — то, чем прораб его называет; два «Санузла» в одном
  /// наборе это ошибка замера, а не данные. Заодно естественный ключ для
  /// наполнения стенда.
  ///
  /// Набор входит в ключ обязательно: «Санузел» есть и до перепланировки,
  /// и после, и это одно помещение в двух состояниях, а не ошибка.
  @@unique([projectId, set, name])
  @@index([projectId, set, order])
  @@map("measure_rooms")
}

/// Проёмы одного вида в помещении: количество, суммарная площадь,
/// суммарные откосы. Одна строка на вид — ровно то, что показывает
/// артборд. Отсутствие окон в санузле выражается отсутствием строки, а не
/// строкой нулей.
model MeasureOpening {
  id     String      @id @default(uuid()) @db.Uuid
  roomId String      @db.Uuid
  kind   OpeningKind
  count  Int
  /// Тысячные доли: площадь в м², откосы в м.п.
  area   BigInt
  reveal BigInt

  room MeasureRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, kind])
  @@map("measure_openings")
}

/// Изображение плана объекта. Один файл на набор обмера, не на помещение:
/// рисованного контура помещения в продукте нет.
///
/// На набор, а не на объект: перепланировка меняет чертёж так же, как меняет
/// площади, и старый план рядом с новыми помещениями сообщал бы неправду
/// уверенно — хуже, чем не сообщал бы ничего.
///
/// В базе только ключ файла; сам файл лежит в хранилище за портом
/// FileStorage. Отдельная таблица, а не колонки в projects: таблица
/// объектов читается списком, сводкой и карточкой, и шесть колонок
/// метаданных файла расширяют её без нужды. Общая сущность вложения
/// появится вместе с фотоотчётами стадии C.4 — тогда эта модель станет
/// её частным случаем.
model MeasurePlan {
  id           String     @id @default(uuid()) @db.Uuid
  projectId    String     @db.Uuid
  set          MeasureSet @default(INITIAL)
  storageKey   String     @unique
  fileName     String
  contentType  String
  byteSize     Int
  uploadedById String?    @db.Uuid
  uploadedAt   DateTime   @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([projectId, set])
  @@map("measure_plans")
}

/// Этап работ объекта — строка графика производства работ.
///
/// Первичный источник дат для экрана «Главная»: полоса плана во времени и
/// процент готовности считаются отсюда, а не из срока объекта. У объекта
/// есть `startedAt` и `deadline`, но это рамка договора, а не работа:
/// внутри неё идут штукатурка, электрика, плитка — каждая своим отрезком.
///
/// Прогресс — базисные пункты, как `supervisionShare`: 5000 = 50,00 %.
/// Целое, а не доля с плавающей точкой, по общему правилу схемы. Величина
/// заявленная: приёмки в продукте ещё нет (стадия D), и до неё прогресс
/// вносит руководитель. Экран обязан называть её заявленной.
///
/// Мастера у этапа нет: назначения и чужие задачи в объём не входят.
/// Бригада есть — но не как исполнитель задачи, а как получатель сдельного
/// начисления: приёмка раздела адресует оплату бригаде его этапа (Р2).
/// Раздел сметы связан с этапом по той же причине: без этой связи вывести
/// бригаду из принимаемого раздела нечем — этапы объекта перекрываются по
/// датам, и «этап, идущий сегодня» не определён однозначно.
model WorkStage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  name      String
  order     Int
  /// Даты без времени: этап меряется днями, час начала штукатурки
  /// значения не имеет и в графике не показывается.
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  progress  Int      @default(0)
  /// Раздел сметы, работы которого ведёт этап. Необязателен: этап может
  /// стоять в графике раньше, чем смета разбита на разделы.
  sectionId String?  @db.Uuid
  /// Бригада-получатель начисления по работам этапа. Необязательна:
  /// график заводится раньше, чем известен исполнитель.
  brigadeId String?  @db.Uuid

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Restrict, а не SetNull: бригада, на которую уже начислено, не должна
  /// исчезать из графика молча.
  brigade Worker?          @relation(fields: [brigadeId], references: [id], onDelete: Restrict)

  /// Имя этапа — то, чем его называют на объекте; два «Электромонтажа» в
  /// одном объекте это ошибка ввода, а не данные.
  @@unique([projectId, name])
  /// Раздел ведёт не более одного этапа: иначе приёмка раздела не знала бы,
  /// чью бригаду брать.
  @@unique([sectionId])
  @@index([projectId, startsOn])
  @@map("work_stages")
}

/// Пакет приёмки — единица работы прораба.
///
/// Прораб принимает не позицию, а помещение: одна фотография комнаты есть
/// свидетельство по всем позициям этой комнаты. Подчинение фотографии
/// отдельной приёмке потребовало бы дублировать ссылку на файл в каждой
/// записи, что лишает свидетельство доказательной силы — нельзя отличить
/// одно свидетельство от двенадцати — и ломает сторно: отмена одной позиции
/// не должна затрагивать фото остальных.
///
/// Бригада хранится снимком, а не читается у этапа при выводе: смена
/// бригады у этапа не должна переписывать то, кому уже начислено.
model AcceptanceBatch {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  sectionId   String   @db.Uuid
  brigadeId   String   @db.Uuid
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  comment     String?
  /// Транш, открытый на момент приёмки. Проставляется при записи и никогда
  /// не пересчитывается: открытие транша задним числом не должно переписывать
  /// уже принятое (БП-04). Пуст у пакетов, записанных до появления траншей —
  /// они показываются разрезом «вне транша», а не приписываются первому.
  trancheId   String?  @db.Uuid

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     EstimateSection   @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  brigade     Worker            @relation(fields: [brigadeId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tranche     Tranche?          @relation(fields: [trancheId], references: [id], onDelete: SetNull)
  acceptances Acceptance[]
  photos      AcceptancePhoto[]

  @@index([projectId, createdAt])
  @@index([trancheId])
  @@map("acceptance_batches")
}

/// Приёмка одной позиции.
///
/// Отмена — сторно, а не удаление (БП-04): создаётся запись того же вида с
/// отрицательным количеством, ссылкой на сторнируемую и обязательной
/// причиной. Принятое по позиции есть сумма количеств, поэтому пара
/// «приёмка + сторно» сама себя обнуляет, а история остаётся целой.
///
/// Сторно живёт в том же пакете, что и сторнируемая приёмка: свидетельство
/// остаётся при своей фотографии, и второго фото сторно не требует.
model Acceptance {
  id          String   @id @default(uuid()) @db.Uuid
  batchId     String   @db.Uuid
  itemId      String   @db.Uuid
  /// Тысячные доли единицы измерения. У сторно отрицательное.
  qty         BigInt
  /// Заполнена у сторно и только у него.
  reason      String?
  reversesId  String?  @unique @db.Uuid
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  batch     AcceptanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item      EstimateItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Самоссылка: одна приёмка сторнируется не более одного раза — это
  /// закреплено уникальностью reversesId, а не проверкой в коде.
  reverses  Acceptance?     @relation("Storno", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal  Acceptance?     @relation("Storno")
  accrual   WageAccrual?

  @@index([itemId])
  @@map("acceptances")
}

/// Начисление сдельной оплаты, порождённое приёмкой (БП-03).
///
/// Ставка хранится снимком: последующее изменение ставки в смете не
/// переписывает уже начисленное. Сумма считается один раз при записи и
/// не пересчитывается при выводе — пересчёт по действующей ставке и был бы
/// тем самым переписыванием.
model WageAccrual {
  id           String   @id @default(uuid()) @db.Uuid
  acceptanceId String   @unique @db.Uuid
  brigadeId    String   @db.Uuid
  /// Снимок ставки позиции на момент приёмки, копейки за единицу.
  unitWage     BigInt
  /// Копейки. Знак следует за количеством: у сторно отрицательная, и пара
  /// складывается в ноль.
  amount       BigInt
  createdAt    DateTime @default(now())

  acceptance Acceptance @relation(fields: [acceptanceId], references: [id], onDelete: Cascade)
  brigade    Worker     @relation(fields: [brigadeId], references: [id], onDelete: Restrict)

  @@index([brigadeId, createdAt])
  @@map("wage_accruals")
}

/// Фотография пакета приёмки. Обязательна: пакет без снимка свидетельством
/// не является. Хранится тем же порядком, что снимок обмерного плана —
/// файл в хранилище, ключ собирает сервер.
model AcceptancePhoto {
  id           String   @id @default(uuid()) @db.Uuid
  batchId      String   @db.Uuid
  storageKey   String   @unique
  fileName     String
  contentType  String
  byteSize     Int
  uploadedById String?  @db.Uuid
  uploadedAt   DateTime @default(now())

  batch      AcceptanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@map("acceptance_photos")
}

/// Расход по объекту, подтверждённый чеком на материалы.
///
/// Отдельная модель, а не `OtherExpense`: тот означает строку
/// импортированной сметы без объёма, её пишет только парсер книги и правке
/// она не подлежит. Смешать их значило бы смешать «цену в смете» и «деньги,
/// потраченные по факту» — величины разных вопросов.
///
/// Расход не входит ни в смету, ни в транш, ни в приёмку: это учёт
/// потраченного, а не изменение цены работ.
///
/// Снимок чека обязателен и лежит теми же шестью колонками, что снимок
/// обмерного плана и фотография пакета приёмки. Это третье повторение
/// одного набора: общая сущность вложения обещана комментарием к
/// `MeasurePlan` и до сих пор не заведена — долг записан в `11_UI_AUDIT.md`.
model MaterialExpense {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @db.Uuid
  status        ExpenseStatus @default(DRAFT)
  kind          ExpenseKind
  /// Копейки целым числом, как все деньги продукта (БП-08).
  amount        BigInt
  /// Возмещается ли заказчиком. Ложь — расход остаётся на студии.
  reimbursable  Boolean       @default(true)
  /// Где куплено. По чеку без продавца расход не проверить.
  seller        String
  /// Дата покупки с чека. Отличается от даты заведения записи.
  spentAt       DateTime      @db.Date
  /// Раздел сметы, к которому отнесён расход. Необязателен: не всякая
  /// покупка ложится на раздел, и принуждать к выбору значило бы получать
  /// неверный раздел вместо пустого.
  sectionId     String?       @db.Uuid
  note          String?
  storageKey    String        @unique
  fileName      String
  contentType   String
  byteSize      Int
  createdById   String?       @db.Uuid
  createdAt     DateTime      @default(now())
  confirmedById String?       @db.Uuid
  confirmedAt   DateTime?

  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation("ExpenseAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  confirmedBy User?            @relation("ExpenseConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([projectId, spentAt])
  @@map("material_expenses")
}

/// Транш — сумма платежа клиента, в счёт которой идёт выработка.
///
/// Величина клиентская, а не стоимость работ: клиент платит смету с
/// надбавкой «сопровождение объекта», и расчёт остатка по стоимости работ
/// расходится с экономикой объекта на 402 726 ₽ (БП-05). Поэтому выработка
/// переводится в клиентскую сумму до вычитания, а надбавка применяется
/// одним умножением к итогу за транш — поэлементное начисление с
/// округлением до копейки накапливает расхождение (`packages/domain/src/tranche.ts`).
///
/// Выработка полем не хранится: она есть сумма принятого по пакетам этого
/// транша. Хранимое поле пришлось бы уменьшать при сторно, то есть
/// переписывать — БП-04 запрещает.
model Tranche {
  id          String        @id @default(uuid()) @db.Uuid
  projectId   String        @db.Uuid
  /// Порядковый номер у объекта. Ноль — предоплата (решение Р12): она
  /// заводится сразу оплаченной, иначе первые 30 % выпадают из картины
  /// денег на карточке объекта.
  number      Int
  /// Копейки. Сумма платежа клиента по этому траншу.
  amount      BigInt
  status      TrancheStatus @default(OPEN)
  openedAt    DateTime      @default(now())
  closedAt    DateTime?
  paidAt      DateTime?
  comment     String?
  createdById String?       @db.Uuid

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  batches   AcceptanceBatch[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@map("tranches")
}

/// Справочник типов ремонта с тарифом за квадратный метр.
///
/// Тарифы правятся на экране настроек, а не зашиты в код: цены меняются
/// чаще, чем выходят редакции продукта (решение заказчика от 11.09.2026).
model RepairType {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @db.Uuid
  name       String
  /// Копейки за квадратный метр.
  ratePerSqm BigInt
  /// Отклонение вилки в сотых долях процента: 1500 — это ±15 %.
  spread     Int    @default(1500)
  order      Int    @default(0)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([orgId, name])
  @@map("repair_types")
}

/// Заявка — обращение до того, как оно стало объектом.
model Lead {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @db.Uuid
  /// Сквозной номер в рамках организации, как в обиходе: № 1044.
  number Int

  name    String
  phone   String
  /// Адрес объекта со слов обратившегося. Нужен при превращении в объект.
  address String?
  note    String?

  stage      LeadStage   @default(FIRST_CONTACT)
  outcome    LeadOutcome @default(OPEN)
  /// Причина отказа. Заполняется вместе с outcome = LOST и только с ним.
  lostReason String?

  repairTypeId   String? @db.Uuid
  /// Общая площадь по документам, тысячные квадратного метра.
  area           BigInt?
  /// Снимок тарифа и отклонения на момент расчёта ориентира.
  ///
  /// По тому же правилу, по которому приёмка хранит снимок ставки (БП-03):
  /// правка справочника не вправе задним числом изменить цену, названную
  /// заказчику по телефону.
  rateSnapshot   BigInt?
  spreadSnapshot Int?

  /// Заведённые превращением. Заявка остаётся и после него.
  clientId  String? @db.Uuid
  projectId String? @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  repairType   RepairType?  @relation(fields: [repairTypeId], references: [id], onDelete: SetNull)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tasks        LeadTask[]

  @@unique([orgId, number])
  @@index([orgId, stage])
  @@map("leads")
}

/// Задача по заявке. Срок и отметка выполнения; просрочка вычисляется по
/// дате, а не хранится признаком — иначе она врёт до первого пересчёта.
model LeadTask {
  id     String @id @default(uuid()) @db.Uuid
  orgId  String @db.Uuid
  leadId String @db.Uuid

  title  String
  dueOn  DateTime  @db.Date
  doneAt DateTime?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_tasks")
}
